    "check-code-formatting": "prettier --check src/",
    "check-markdown-docs": "autogen-markdown-doc check",
    "prepack": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@doikayt/typescript-build-config": "^0.1.19",
    "vitest": "^4.1.10",
