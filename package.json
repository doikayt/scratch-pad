{
  "name": "@datalackey/scratch-pad",
  "version": "1.0.1",
  "description": "",
  "scripts": {
    "ci": "npm run check-all-format && npm run test",
    "build": "tsc",
    "test": "vitest run",
    "update-all-format": "npm run update-code-formatting && npm run update-markdown-docs",
